# Django secret key (generate a random 50+ character string)
DJANGO_SECRET_KEY=change-me-to-a-very-secure-random-secret-key

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed host domains
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Comma-separated list of allowed frontend origins (your Vercel URL)
DJANGO_CORS_ORIGINS=https://your-hospital-frontend.vercel.app

# Optional: PostgreSQL connection URL (e.g., from Render Postgres, Supabase, Neon)
# If omitted, local SQLite is used by default
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Optional: Power BI embed URL
POWERBI_REPORT_URL=
